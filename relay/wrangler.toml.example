# Copy to wrangler.toml (untracked) and fill in your own names.
# Relay Worker for online play. Public: not behind Access.
name = "your-relay-worker"
main = "worker.js"
compatibility_date = "2026-09-01"
# No route here: add your own, then put its wss:// address in game/deploy.cfg.
# routes = [{ pattern = "relay.example.com", custom_domain = true }]

[[durable_objects.bindings]]
name = "ROOMS"
class_name = "RoomObject"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["RoomObject"]
